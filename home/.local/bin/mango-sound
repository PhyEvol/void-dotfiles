#!/usr/bin/env bash
# Reproduce un sonido corto. Uso: mango-sound [/ruta/al/audio]
# Sin argumento usa $MANGO_SOUND, luego el archivo histórico si existe y,
# por último, el sonido de campana del sistema.
if [ -n "${1:-}" ]; then
  SOUND="$1"
elif [ -n "${MANGO_SOUND:-}" ]; then
  SOUND="$MANGO_SOUND"
elif [ -f "$HOME/Music/youtube/worry-l.opus" ]; then
  SOUND="$HOME/Music/youtube/worry-l.opus"
else
  SOUND="/usr/share/sounds/freedesktop/stereo/bell.oga"
fi
VOLUME="1.0"

[ -f "$SOUND" ] || { notify-send "mango-sound" "No existe: $SOUND"; exit 1; }

# Si ya está sonando, lo detiene y sale
if pgrep -f "pw-play.*$SOUND" >/dev/null; then
    pkill -f "pw-play.*$SOUND"
    exit 0
fi

if command -v pw-play >/dev/null; then
    exec pw-play --volume "$VOLUME" "$SOUND"
elif command -v paplay >/dev/null; then
    exec paplay "$SOUND"
else
    notify-send "mango-sound" "Falta pw-play o paplay"
    exit 1
fi
